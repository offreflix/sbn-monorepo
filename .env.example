# Root .env.example for SBN Monorepo
# Copy this file to create .env files in each service

# IMPORTANT: All services must use the SAME JWT_SECRET
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database connection (PostgreSQL on port 5433)
DATABASE_URL=postgresql://admin:password@localhost:5433/sbn_db?schema=public

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Service URLs (for orchestrator)
AUTH_SERVICE_URL=http://localhost:3001
FINANCE_SERVICE_URL=http://localhost:3002

# Frontend API base URL
VITE_API_BASE=http://localhost:3000

# ==================================================
# Service-specific .env files needed:
# ==================================================

# apps/auth/.env:
# - DATABASE_URL
# - JWT_SECRET  (must match orchestrator!)
# - REDIS_HOST
# - REDIS_PORT

# apps/finance/.env:
# - DATABASE_URL

# apps/orchestrator/.env:
# - AUTH_SERVICE_URL
# - FINANCE_SERVICE_URL
# - REDIS_HOST
# - REDIS_PORT
# - JWT_SECRET  (must match auth!)

# apps/host/.env:
# - VITE_API_BASE

# apps/sbn-finance-mfe/.env:
# - VITE_API_BASE
