# Root .env.example for SBN Monorepo
# Copy this file to create .env files in each service

# IMPORTANT: All services must use the SAME JWT_SECRET
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database connection (PostgreSQL on port 5433)
DATABASE_URL=postgresql://admin:password@localhost:5433/sbn_db?schema=public

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# Service URLs (for orchestrator)
AUTH_SERVICE_URL=http://localhost:56081
FINANCE_SERVICE_URL=http://localhost:56082
HEALTH_SERVICE_URL=http://localhost:56083

# Frontend API base URL
VITE_API_BASE=http://localhost:56080

# Local network access (docker-compose build args)
# Set to your machine's local IP to access from mobile on the same network
# Example: LOCAL_IP=192.168.0.234
LOCAL_IP=

# ==================================================
# Service-specific .env files needed:
# ==================================================

# apps/auth/.env:
# - DATABASE_URL
# - JWT_SECRET  (must match orchestrator!)
# - REDIS_HOST
# - REDIS_PORT

# apps/finance/.env:
# - DATABASE_URL

# apps/orchestrator/.env:
# - AUTH_SERVICE_URL
# - FINANCE_SERVICE_URL
# - REDIS_HOST
# - REDIS_PORT
# - JWT_SECRET  (must match auth!)

# apps/host/.env:
# - VITE_API_BASE

# apps/sbn-finance-mfe/.env:
# - VITE_API_BASE

# apps/sbn-finance-mfe build args (docker-compose):
# - MFE_ASSET_PREFIX (set via LOCAL_IP)

# apps/sbn-health-mfe build args (docker-compose):
# - MFE_ASSET_PREFIX (set via LOCAL_IP)

# apps/host build args (docker-compose):
# - VITE_API_BASE (set via LOCAL_IP)
# - VITE_FINANCE_MFE_URL (set via LOCAL_IP)
# - VITE_HEALTH_MFE_URL (set via LOCAL_IP)
