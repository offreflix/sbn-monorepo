generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/client-finance"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  name              String
  type              String // Enum handled as string or PG Enum, using string for simplicity initially
  balance           Decimal   @default(0.0000) @db.Decimal(19, 4)
  currency          String    @default("BRL")
  isActive          Boolean   @default(true) @map("is_active")
  invoiceClosingDay Int?      @map("invoice_closing_day")
  invoiceDueDay     Int?      @map("invoice_due_day")
  limit             Decimal?  @db.Decimal(19, 4)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  // user relation removed
  transactions Transaction[]
  recurrences  Recurrence[]

  @@map("wallets")
}

model Category {
  id        String    @id @default(uuid())
  userId    String?   @map("user_id")
  name      String
  type      String // Enum: Receita, Despesa
  icon      String?
  color     String?
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // user relation removed
  transactions Transaction[]
  recurrences  Recurrence[]

  @@map("categories")
}

model Transaction {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  walletId           String    @map("wallet_id")
  categoryId         String    @map("category_id")
  amount             Decimal   @db.Decimal(19, 4)
  currency           String    @default("BRL")
  date               DateTime
  description        String?
  status             String // Enum: Pendente, Pago, Cancelado
  type               String // Enum: Receita, Despesa
  tags               String[]
  isPaid             Boolean   @default(false) @map("is_paid")
  installmentNumber  Int?      @map("installment_number")
  totalInstallments  Int?      @map("total_installments")
  purchaseGroupId    String?   @map("purchase_group_id")
  recurrenceId       String?   @map("recurrence_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  // user relation removed
  wallet     Wallet      @relation(fields: [walletId], references: [id])
  category   Category    @relation(fields: [categoryId], references: [id])
  recurrence Recurrence? @relation(fields: [recurrenceId], references: [id])

  @@map("transactions")
}

model Recurrence {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  walletId      String    @map("wallet_id")
  categoryId    String    @map("category_id")
  amount        Decimal   @db.Decimal(19, 4)
  currency      String    @default("BRL")
  description   String?
  type          String // Enum: Receita, Despesa
  frequency     String // Enum: MONTHLY, WEEKLY
  startDate     DateTime  @map("start_date")
  endDate       DateTime? @map("end_date")
  lastGenerated DateTime? @map("last_generated")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // user relation removed
  wallet       Wallet        @relation(fields: [walletId], references: [id])
  category     Category      @relation(fields: [categoryId], references: [id])
  transactions Transaction[]

  @@map("recurrences")
}

model WishlistItem {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  name        String
  description String?
  price       Decimal?  @db.Decimal(19, 4)
  currency    String    @default("BRL")
  url         String?   // Link para o produto
  imageUrl    String?   @map("image_url")
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH
  status      String    @default("WISHED") // WISHED, PURCHASED, REMOVED
  tags        String[]
  notes       String?
  purchasedAt DateTime? @map("purchased_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("wishlist_items")
}
