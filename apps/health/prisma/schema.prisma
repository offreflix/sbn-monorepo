generator client {
  provider        = "prisma-client-js"
  output          = "../../../node_modules/@prisma/client-health"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["health"]
}

enum MealType {
  breakfast
  lunch
  dinner
  snack

  @@schema("health")
}

model Goal {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  dailyCalorieGoal Int      @default(2000) @map("daily_calorie_goal")
  proteinGoalG     Int      @map("protein_goal_g")
  carbsGoalG       Int      @map("carbs_goal_g")
  fatGoalG         Int      @map("fat_goal_g")
  waterGoalMl      Int      @default(2000) @map("water_goal_ml")
  activeFrom       DateTime @default(now()) @db.Date @map("active_from")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, activeFrom])
  @@map("goals")
  @@schema("health")
}

model Food {
  id                 String    @id @default(uuid())
  name               String
  brand              String?
  servingSizeValue   Decimal   @db.Decimal(8, 2) @map("serving_size_value")
  servingSizeUnit    String    @map("serving_size_unit")
  caloriesPerServing Int       @map("calories_per_serving")
  proteinPerServing  Decimal?  @db.Decimal(6, 2) @map("protein_per_serving")
  carbsPerServing    Decimal?  @db.Decimal(6, 2) @map("carbs_per_serving")
  fatPerServing      Decimal?  @db.Decimal(6, 2) @map("fat_per_serving")
  isCustom           Boolean   @default(false) @map("is_custom")
  userId             String?   @map("user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  mealLogs MealLog[]

  @@map("foods")
  @@schema("health")
}

model MealLog {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  foodId         String?  @map("food_id")
  mealType       MealType @map("meal_type")
  loggedAtDate   DateTime @db.Date @map("logged_at_date")
  amountConsumed Decimal  @db.Decimal(8, 2) @map("amount_consumed")
  unitConsumed   String   @map("unit_consumed")
  calcCalories   Int      @map("calc_calories")
  calcProtein    Decimal? @db.Decimal(6, 2) @map("calc_protein")
  calcCarbs      Decimal? @db.Decimal(6, 2) @map("calc_carbs")
  calcFat        Decimal? @db.Decimal(6, 2) @map("calc_fat")
  createdAt      DateTime @default(now()) @map("created_at")

  food Food? @relation(fields: [foodId], references: [id], onDelete: SetNull)

  @@index([userId, loggedAtDate])
  @@map("meal_logs")
  @@schema("health")
}

model UserMeasurement {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  weightKg   Decimal? @db.Decimal(5, 2) @map("weight_kg")
  measuredAt DateTime @db.Date @map("measured_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, measuredAt])
  @@map("user_measurements")
  @@schema("health")
}

model WaterLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  volumeMl   Int      @map("volume_ml")
  loggedDate DateTime @db.Date @map("logged_date")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, loggedDate])
  @@map("water_logs")
  @@schema("health")
}
